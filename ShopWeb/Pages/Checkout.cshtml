@page
@model ShopWeb.Pages.CheckoutModel
@{
    ViewData["Title"] = "Thanh toán";
}

<link rel="stylesheet" href="~/css/checkout.css" />

<div class="checkout-container">
    <h2>📦 Thông tin đặt hàng</h2>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="success" style="padding: 40px; text-align: center;">
            <h3 style="color: #52c41a; font-size: 24px;">@Model.SuccessMessage</h3>
            <p>Cảm ơn bạn đã mua sắm tại Đom Đóm nhỏ!</p>
            <br />
            <a href="/Index" class="order-btn" style="text-decoration: none; padding: 10px 20px; display: inline-block; width: auto;">Quay lại Trang chủ</a>
        </div>
    }
    else if (Model.Cart == null || Model.Cart.Items == null || !Model.Cart.Items.Any())
    {
        <div class="empty-cart">❌ Giỏ hàng của bạn đang trống. Không thể đặt hàng!</div>
        <div style="text-align: center; margin-top: 20px;">
            <a href="/Index" style="color: #ee4d2d; font-weight: bold; text-decoration: none;">&larr; Quay lại chọn món</a>
        </div>
    }
    else
    {
        <form method="post">
            <div class="form-group">
                <label>Họ và tên</label>
                <input asp-for="Order.FullName" required />
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                <input asp-for="Order.Phone" required />
            </div>

            <div class="form-group">
                <label>Địa chỉ</label>
                <input asp-for="Order.Address" required />
            </div>

            <div class="form-group">
                <label>Ghi chú</label>
                <textarea asp-for="Order.Note"></textarea>
            </div>

            <h3>🛒 Sản phẩm</h3>

            <table class="cart-table">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>SL</th>
                        <th>Giá</th>
                        <th>Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Cart.Items)
                    {
                        var total = item.Product.Price * item.Quantity;
                        <tr>
                            <td>@item.Product.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.Product.Price.ToString("N0")</td>
                            <td>@total.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3>💰 Tổng tiền: @Model.Cart.TotalAmount.ToString("N0") đ</h3>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error">@Model.ErrorMessage</div>
            }

            <button type="submit" class="order-btn">Xác nhận đặt hàng</button>
        </form>
    }
</div>