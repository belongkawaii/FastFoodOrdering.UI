@page
@model ShopWeb.Pages.CheckoutModel
@{
    ViewData["Title"] = "Thanh toán";
    ViewData["HeroBadge"] = "Hoàn tất đơn hàng";
    ViewData["HeroTitle"] = "Xác nhận thông tin giao hàng";
    ViewData["HeroSubtitle"] = "Kiểm tra thông tin liên hệ, địa chỉ và phương thức thanh toán trước khi gửi đơn.";
}

<link rel="stylesheet" href="~/css/checkout.css" />

<partial name="_SiteHeader" />

<div class="site-shell-main site-shell-main--narrow">
<div class="checkout-container">
    <h2>📦 Thông tin đặt hàng</h2>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="success" style="padding: 40px; text-align: center;">
            <h3 style="color: #52c41a; font-size: 24px;">@Model.SuccessMessage</h3>
            <p>Cảm ơn bạn đã mua sắm tại Đom Đóm nhỏ!</p>
            <br />
            <a href="/Index" class="order-btn" style="text-decoration: none; padding: 10px 20px; display: inline-block; width: auto;">Quay lại Trang chủ</a>
        </div>
    }
    else if (Model.Cart == null || Model.Cart.Items == null || !Model.Cart.Items.Any())
    {
        <div class="empty-cart">❌ Giỏ hàng của bạn đang trống. Không thể đặt hàng!</div>
        <div style="text-align: center; margin-top: 20px;">
            <a href="/Index" style="color: #ee4d2d; font-weight: bold; text-decoration: none;">&larr; Quay lại chọn món</a>
        </div>
    }
    else
    {
        <form method="post">
            <div class="form-group">
                <label>Họ và tên</label>
                <input asp-for="Order.FullName" required />
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                <input asp-for="Order.Phone"
                       required
                       inputmode="numeric"
                       autocomplete="tel"
                       maxlength="13"
                       placeholder="Ví dụ: 0901 234 567" />
                <small class="field-hint">Nhập số điện thoại liên hệ để cửa hàng xác nhận đơn hàng.</small>
            </div>

            <div class="form-group">
                <label>Địa chỉ</label>
                <input asp-for="Order.Address" required />
            </div>

            <div class="form-group">
                <label>Ghi chú</label>
                <textarea asp-for="Order.Note"></textarea>
            </div>

            <h3>🛒 Sản phẩm</h3>

            <table class="cart-table">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>SL</th>
                        <th>Giá</th>
                        <th>Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Cart.Items)
                    {
                        var total = item.Product.Price * item.Quantity;
                        <tr>
                            <td>@item.Product.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.Product.Price.ToString("N0")</td>
                            <td>@total.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3>💰 Tổng tiền: @Model.Cart.TotalAmount.ToString("N0") đ</h3>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error">@Model.ErrorMessage</div>
            }

            
            <h3>💳 Phương thức thanh toán</h3>
            <div class="payment-methods" style="margin-bottom: 20px;">
                <div style="margin-bottom: 10px;">
                    <input type="radio" asp-for="Order.PaymentMethod" value="0" id="payCOD" checked onclick="toggleQR(false)">
                    <label for="payCOD">Thanh toán khi nhận hàng (COD)</label>
                </div>
                <div>
                    <input type="radio" asp-for="Order.PaymentMethod" value="1" id="payTransfer" onclick="toggleQR(true)">
                    <label for="payTransfer">Chuyển khoản ngân hàng (VietQR)</label>
                </div>
            </div>

            <div id="qr-section" style="display: none; border: 1px dashed #ee4d2d; padding: 20px; text-align: center; border-radius: 8px; margin-bottom: 20px; background-color: #fffaf9;">
                <h4>Quét mã QR để thanh toán</h4>
                @{
                    // Giả lập thông tin ngân hàng
                    var bankId = "970436"; // Vietcombank
                    var accountNo = "123456789";
                    var accountName = "SHOP DOM DOM NHO";
                    var amount = Model.Cart?.TotalAmount ?? 0;
                    var description = $"Thanh toan don hang {DateTime.Now:yyyyMMddHHmm}";
                    var qrUrl = $"https://img.vietqr.io/image/{bankId}-{accountNo}-compact2.png?amount={amount}&addInfo={Uri.EscapeDataString(description)}&accountName={Uri.EscapeDataString(accountName)}";
                }
                <img src="@qrUrl" alt="Mã QR Thanh toán" style="max-width: 250px; border: 5px solid #fff; box-shadow: 0 0 10px rgba(0,0,0,0.1);" />
                <p style="font-size: 14px; color: #555; margin-top: 10px;">Vui lòng quét mã và thực hiện chuyển khoản.</p>
                
                <div style="margin-top: 15px;">
                    <input type="checkbox" id="confirmPaid" onchange="validatePayment()">
                    <label for="confirmPaid" style="font-weight: bold; color: #ee4d2d;">Tôi đã chuyển khoản thành công</label>
                </div>
            </div>

            <button type="submit" id="submitBtn" class="order-btn">Xác nhận đặt hàng</button>
        </form>
    }
</div>
</div>

<script src="~/js/checkout.js" asp-append-version="true"></script>
<script src="~/js/checkout-form.js" asp-append-version="true"></script>
<script>
    function toggleQR(show) {
        const qrSection = document.getElementById('qr-section');
        const submitBtn = document.getElementById('submitBtn');
        const confirmPaid = document.getElementById('confirmPaid');

        if (show) {
            qrSection.style.display = 'block';
            submitBtn.disabled = true; // Khóa nút nếu chưa tích "Đã chuyển khoản"
            submitBtn.style.opacity = '0.5';
        } else {
            qrSection.style.display = 'none';
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
        }
    }

    function validatePayment() {
        const confirmPaid = document.getElementById('confirmPaid');
        const submitBtn = document.getElementById('submitBtn');
        
        if (confirmPaid.checked) {
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
        } else {
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.5';
        }
    }
</script>
<partial name="_SiteFooter" />
