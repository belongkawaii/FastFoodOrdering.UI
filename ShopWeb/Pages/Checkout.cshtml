@page
@model ShopWeb.Pages.CheckoutModel

<h2>🛒 Thanh toán</h2>

<!-- 🔥 THÔNG BÁO -->
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div style="color:red">@Model.ErrorMessage</div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="color:green">@Model.SuccessMessage</div>
}

<hr />

<!-- 🔥 GIỎ HÀNG -->
@if (Model.Cart != null && Model.Cart.Items != null && Model.Cart.Items.Any())
{
    <h3>📦 Giỏ hàng</h3>

    <table border="1" cellpadding="10" cellspacing="0">
        <thead>
            <tr>
                <th>Tên</th>
                <th>Số lượng</th>
                <th>Giá</th>
                <th>Tổng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Cart.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.Price</td>
                    <td>@(item.Price * item.Quantity)</td>
                </tr>
            }
        </tbody>
    </table>

    <h3>
        Tổng tiền: 
        @Model.Cart.Items.Sum(x => x.Price * x.Quantity)
    </h3>
}
else
{
    <p>❌ Giỏ hàng trống</p>
}

<hr />

<!-- 🔥 FORM ĐẶT HÀNG -->
<h3>📋 Thông tin khách hàng</h3>

<form method="post">
    <div>
        <label>Họ tên:</label><br />
        <input asp-for="Order.FullName" />
    </div>

    <div>
        <label>Số điện thoại:</label><br />
        <input asp-for="Order.Phone" />
    </div>

    <div>
        <label>Địa chỉ:</label><br />
        <input asp-for="Order.Address" />
    </div>

    <!-- ❌ ĐÃ XÓA Order.Note vì DTO không có -->

    <br />

    <button type="submit">✅ Đặt hàng</button>
</form>