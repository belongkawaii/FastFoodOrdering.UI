@page
@using System.Net
@model AdminPageModel
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["HeroBadge"] = "Trang quản trị";
    ViewData["HeroTitle"] = "Điều phối vận hành cửa hàng";
    ViewData["HeroSubtitle"] = "Quản lý sản phẩm, tài khoản và đơn hàng trong cùng một giao diện đồng bộ với toàn website.";
}

<!-- CSS -->
<link rel="stylesheet" href="~/css/signup.css">
<link rel="stylesheet" href="~/css/admin.css">

<partial name="_SiteHeader" />

<!-- ADMIN LAYOUT -->
<div class="site-shell-main site-shell-main--wide">
<div class="admin-container">

    <!-- Sidebar -->
    <div class="sidebar">
        <h2 class="sidebar-title">Administrator</h2>
        <ul>
            <li><a href="#" class="menu-item active" onclick="showSection('dashboard', this)">Dashboard</a></li>
            <li><a href="#" class="menu-item" onclick="showSection('products', this)">Quản lý sản phẩm</a></li>
            <li><a href="#" class="menu-item" onclick="showSection('users', this)">Quản lý tài khoản</a></li>
            <li><a href="#" class="menu-item" onclick="showSection('orders', this)">Đơn hàng</a></li>
            <li><a href="#" class="menu-item" onclick="showSection('settings', this)">Cài đặt</a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">

        <!-- Dashboard -->
            <div id="dashboard" class="section active">
    <h2>Dashboard</h2>

    <div class="dashboard-grid">

        <div class="left-panel">

            <!-- Đơn hàng cần xử lý -->
            <div class="card">
                <h3>🧾 Đơn hàng cần xử lý</h3> 

                <table>
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Thời gian</th>
                            <th>Trạng Thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Trần Hữu Quốc Thái</td>
                            <td>10:30 - 31/03</td>
                            <td>Chưa xác nhận</td>
                            <td>
                                <span class="detail">Xem chi tiết</span>
                            </td>
                        </tr>
                        <tr>
                            <td>Trần Nguyễn Son Son</td>
                            <td>11:00 - 31/03</td>
                            <td>Chưa xác nhận</td>
                            <td>
                                <span class="detail">Xem chi tiết</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

             <!-- Doanh thu -->
             <div class="card">
                <h3>💰 Doanh thu hôm nay</h3>
                <p class="revenue">36,000,000 VND</p>
             </div>
        </div>
        <div class="right-panel">

            <!-- Thống kê -->
            <div class="card">
            <h3>Thống kê</h3>

            <div class="big-chart">
                <div class="pie-chart"></div>

                <div class="chart-legend">
                    <p><span class="dot done"></span> Hoàn thành (70%)</p>
                    <p><span class="dot processing"></span> Đang xử lý (20%)</p>
                    <p><span class="dot cancel"></span> Hủy (10%)</p>
                </div>
            </div>
             </div>

            <!-- Đánh giá -->
            <div class="card">
                <h3>Đánh giá khách hàng</h3>

                <div class="review">
                    <p><b>Hằng Ma Đại Thánh</b></p>
                    <p>⭐⭐⭐⭐⭐</p>
                    <p>thử lần 1 ngon, lần 2 ngon hơn, lần 3 rất ngon</p>
                    <span class="detail">Xem chi tiết</span>
                </div>

                <div class="review">
                    <p><b>Thiên Cuồng Bạo Quân</b></p>
                    <p>⭐⭐⭐⭐</p>
                    <p>"Đồ ăn ngon"</p>
                    <span class="detail">Xem chi tiết</span>
                </div>

            </div>

        </div>

    </div>
</div>

        <!-- Product Management -->
        <div id="products" class="section">
            <h2>Quản lý sản phẩm</h2>

            <button class="btn-confirm" onclick="location.href='/AddProductAdmin'">+ Thêm sản phẩm</button>

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr>
                            <td>@p.id</td>
                            <td>@p.name</td>
                            <td>@p.price.ToString("N0") VND</td>
                            <td>
                                <input type="number"
                                value="1"
                                min="0"
                                class="quantity-input"
                                data-id="@p.id" />
                            </td>
                            <td style="text-align:right;">
                                <button class="btn-update" onclick="location.href='/ProductDetail/@p.id'"> Sửa </button>
                                
                                <button id="btn-delete-@p.id" type="button" onclick="Delete(@p.id)" class="btn-danger" style="cursor:pointer;">
                                    <i class="fas fa-trash"></i> Xóa
                                </button>
                            </td>

                            @Html.AntiForgeryToken()
                        </tr>
                    }
                </tbody>
                </table>
        </div>

        <!-- User Management -->
        <div id="users" class="section">
            <h2>Quản lý tài khoản</h2>

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="user-list">
                    <!-- DATA API -->
                    <tr>
                        <td>1</td>
                        <td>admin@gmail.com</td>
                        <td>Admin</td>
                        <td>Hoạt động</td>
                        <td>
                            <button>Khóa</button>
                            <button>Xóa</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Orders -->
        <div id="orders" class="section">
            <h2>Lịch Sử Đơn Hàng</h2>
            <!-- Đơn hàng cũ -->
            <div class="card">
                <h3>Đơn hàng đã xử lý</h3>

                <table>
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Thời gian đặt hàng</th>
                            <th>Thời gian hoàn thành</th>
                            <th>Phương thức thanh toán</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Nham Vương Đế Quân</td>
                            <td>29/03</td>
                            <td>29/03</td>
                            <td>Momo</td>
                            <td>Đã nhận</td>
                        </tr>
                        <tr>
                            <td>Bạch Mã Tiên Nhân</td>
                            <td>28/03</td>
                            <td>28/03</td>
                            <td>Trực tiếp</td>
                            <td>Đã nhận</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Settings -->
        <div id="settings" class="section">
            <h2>⚙️Cài đặt</h2>
            <p>Thiết lập hệ thống...</p>
        </div>

    </div>
</div>
</div>
<partial name="_SiteFooter" />

<!-- SCRIPT -->
<script src="~/js/admin.js">
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
        document.addEventListener("DOMContentLoaded", function () {
        // Lấy dữ liệu từ TempData thông qua Razor
        var successMsg = "@Html.Raw(TempData["SuccessMsg"])";
        var errorMsg = "@Html.Raw(TempData["ErrorMsg"])";

        if (successMsg) {
        Swal.fire({
        icon: 'success',
        title: 'Thành công!',
        text: successMsg,
        timer: 2000,
        showConfirmButton: false
        });
        }

        if (errorMsg) {
        Swal.fire({
        icon: 'error',
        title: 'Rất tiếc...',
        text: errorMsg,
        confirmButtonColor: '#d33'
        });
        }
        });

        function Delete(id) {
    Swal.fire({
        title: 'Xóa sản phẩm?',
        text: "Bạn có chắc chắn muốn xóa sản phẩm #" + id + " không?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ff4d4f',
        cancelButtonColor: '#ccc',
        confirmButtonText: 'Đồng ý xóa!',
        cancelButtonText: 'Không'
    }).then((result) => {
        if (result.isConfirmed) {
            executeDelete(id);
        }
    })
}

function executeDelete(id) {
    // 1. Lấy Token chống giả mạo (CSRF)
    const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
    if (!tokenElement) {
        console.error("Không tìm thấy AntiForgeryToken!");
        return;
    }
    const csrfToken = tokenElement.value;

    // 2. Gọi vào Page Handler "DeleteProduct" 
    // Sử dụng phương thức POST thay vì DELETE vì Razor Page Handler mặc định nhận POST
    fetch(`?handler=DeleteProduct&id=${id}`, {
        method: 'POST', 
        headers: { 
            'RequestVerificationToken': csrfToken 
        }
    })
    .then(res => {
        if (res.ok) {
            Swal.fire('Thành công!', 'Sản phẩm đã được xóa.', 'success')
                .then(() => location.reload()); // Tải lại trang để cập nhật danh sách [cite: 42]
        } else {
            Swal.fire('Lỗi!', 'API không cho phép xóa hoặc lỗi hệ thống.', 'error');
        }
    })
    .catch(err => {
        Swal.fire('Lỗi', 'Không thể kết nối tới máy chủ!', 'error');
    });
}
</script>
