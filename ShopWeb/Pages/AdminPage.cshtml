@page
@using System.Net
@model AdminPageModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- CSS -->
<link rel="stylesheet" href="~/css/signup.css">
<link rel="stylesheet" href="~/css/admin.css">

<!-- Banner -->
<div class="top-banner">
    <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200">
</div>

<!-- Navbar -->
<div class="navbar">
    <div class="left">
        <a asp-page="/Index">Trang chủ</a>
        <a href="/ComingSoon">Giới thiệu</a>
        <a href="/ComingSoon">Món ăn đề xuất</a>
    </div>
    <div class="right">
            @{
                var token = HttpContext.Request.Cookies["AuthToken"];
                var user = HttpContext.Request.Cookies["UserName"];
            }

            @if (!string.IsNullOrEmpty(token))
            {
                <span class="greeting">Xin chào, @user</span>
                <a asp-page="/Logout">Đăng xuất</a>
            }
            else
            {
                <a asp-page="/Signin">Đăng nhập</a>
                <a asp-page="/Signup">Đăng ký</a>
            }
        </div>
</div>

<!-- ADMIN LAYOUT -->
<div class="admin-container">

    <!-- Sidebar -->
    <div class="sidebar">
        <h2 class="sidebar-title">Administrator</h2>
        <ul>
            <li><a href="#" class="menu-item active" onclick="showSection('dashboard', this)">Dashboard</a></li>
            <li><a href="#" class="menu-item" onclick="showSection('products', this)">Quản lý sản phẩm</a></li>
            <li><a href="#" class="menu-item" onclick="showSection('users', this)">Quản lý tài khoản</a></li>
            <li><a href="#" class="menu-item" onclick="showSection('orders', this)">Đơn hàng</a></li>
            <li><a href="#" class="menu-item" onclick="showSection('settings', this)">Cài đặt</a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">

        <!-- Dashboard -->
            <div id="dashboard" class="section active">
    <h2>Dashboard</h2>

    <div class="dashboard-grid">

        <div class="left-panel">

            <!-- Đơn hàng cần xử lý -->
            <div class="card">
                <h3>🧾 Đơn hàng cần xử lý</h3> 

                <table>
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Thời gian</th>
                            <th>Trạng Thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Trần Hữu Quốc Thái</td>
                            <td>10:30 - 31/03</td>
                            <td>Chưa xác nhận</td>
                            <td>
                                <span class="detail">Xem chi tiết</span>
                            </td>
                        </tr>
                        <tr>
                            <td>Trần Nguyễn Son Son</td>
                            <td>11:00 - 31/03</td>
                            <td>Chưa xác nhận</td>
                            <td>
                                <span class="detail">Xem chi tiết</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

             <!-- Doanh thu -->
             <div class="card">
                <h3>💰 Doanh thu hôm nay</h3>
                <p class="revenue">36,000,000 VND</p>
             </div>
        </div>
        <div class="right-panel">

            <!-- Thống kê -->
            <div class="card">
            <h3>Thống kê</h3>

            <div class="big-chart">
                <div class="pie-chart"></div>

                <div class="chart-legend">
                    <p><span class="dot done"></span> Hoàn thành (70%)</p>
                    <p><span class="dot processing"></span> Đang xử lý (20%)</p>
                    <p><span class="dot cancel"></span> Hủy (10%)</p>
                </div>
            </div>
             </div>

            <!-- Đánh giá -->
            <div class="card">
                <h3>Đánh giá khách hàng</h3>

                <div class="review">
                    <p><b>Dương Trung Thực</b></p>
                    <p>⭐⭐⭐⭐⭐</p>
                    <p>thử lần 1 ngon, lần 2 ngon hơn, lần 3 rất ngon</p>
                    <span class="detail">Xem chi tiết</span>
                </div>

                <div class="review">
                    <p><b>A Minimum</b></p>
                    <p>⭐⭐⭐⭐</p>
                    <p>"Đồ ăn ngon nhưng không ngon bằng em"</p>
                    <span class="detail">Xem chi tiết</span>
                </div>

            </div>

        </div>

    </div>
</div>

        <!-- Product Management -->
        <div id="products" class="section">
            <h2>Quản lý sản phẩm</h2>

            <button class="btn-confirm" onclick="location.href='/AddProductAdmin'">+ Thêm sản phẩm</button>

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr>
                            <td>@p.id</td>
                            <td>@p.name</td>
                            <td>@p.price.ToString("N0") VND</td>
                            <td>
                                <input type="number"
                                value="1"
                                min="0"
                                class="quantity-input"
                                data-id="@p.id" />
                            </td>
                            <td style="text-align:right;">
                                <button class="btn-update" onclick="location.href='/ProductDetail/@p.id'"> Sửa </button>
                                <form method="post" asp-page-handler="DeleteProduct" asp-route-id="@p.id" 
                                    onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')">
                                    
                                    <button class="btn-danger" style="cursor:pointer;">
                                        <i class="fas fa-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
        </div>

        <!-- User Management -->
        <div id="users" class="section">
            <h2>Quản lý tài khoản</h2>

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="user-list">
                    <!-- DATA API -->
                    <tr>
                        <td>1</td>
                        <td>admin@gmail.com</td>
                        <td>Admin</td>
                        <td>Hoạt động</td>
                        <td>
                            <button>Khóa</button>
                            <button>Xóa</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Orders -->
        <div id="orders" class="section">
            <h2>Lịch Sử Đơn Hàng</h2>
            <!-- Đơn hàng cũ -->
            <div class="card">
                <h3>Đơn hàng đã xử lý</h3>

                <table>
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Thời gian đặt hàng</th>
                            <th>Thời gian hoàn thành</th>
                            <th>Phương thức thanh toán</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Tinh Gia Miền Tây</td>
                            <td>29/03</td>
                            <td>29/03</td>
                            <td>Momo</td>
                            <td>Đã nhận</td>
                        </tr>
                        <tr>
                            <td>Trịnh Trần Phương Tún</td>
                            <td>28/03</td>
                            <td>28/03</td>
                            <td>Trực tiếp</td>
                            <td>Đã nhận</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Settings -->
        <div id="settings" class="section">
            <h2>⚙️Cài đặt</h2>
            <p>Thiết lập hệ thống...</p>
        </div>

    </div>
</div>

<!-- Footer -->
<div class="footer">
    <div class="left">
        <h3>Đom Đóm nhỏ HCMUE</h3>
        <p>SĐT: 0999999999</p>
        <p>Địa chỉ: Trường ĐH Sư phạm TP.HCM</p>
    </div>

    <div class="right">
        <iframe 
            src="https://www.google.com/maps?q=Đại học Sư phạm TP.HCM&output=embed">
        </iframe>
    </div>
</div>

<!-- SCRIPT -->
<script src="~/js/admin.js">
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
        document.addEventListener("DOMContentLoaded", function () {
        // Lấy dữ liệu từ TempData thông qua Razor
        var successMsg = "@Html.Raw(TempData["SuccessMsg"])";
        var errorMsg = "@Html.Raw(TempData["ErrorMsg"])";

        if (successMsg) {
        Swal.fire({
        icon: 'success',
        title: 'Thành công!',
        text: successMsg,
        timer: 2000,
        showConfirmButton: false
        });
        }

        if (errorMsg) {
        Swal.fire({
        icon: 'error',
        title: 'Rất tiếc...',
        text: errorMsg,
        confirmButtonColor: '#d33'
        });
        }
        });
</script>