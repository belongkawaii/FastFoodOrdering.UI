@page "{id?}"
@model ProductDetailModel
@using System.Globalization
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    // Giả sử giá trị là decimal hoặc int
    decimal price = 50000; 
    var formattedPrice = string.Format(new CultureInfo("vi-VN"), "{0:N0} ₫", price);
}

<link rel="stylesheet" href="~/css/productdetail.css" />
<link rel="stylesheet" href="~/css/site.css" />

<!-- 🔥 Banner -->
<div class="banner">
    <img id="banner-img" src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200">
</div>

<!-- Navbar -->
<div class="navbar">
    <div class="left">
        <a asp-page="/Index">Trang chủ</a>
        <a href="#">Giới thiệu</a>
        <a href="#">Món ăn đề xuất</a>
    </div>
    <div class="right">
            @{
                var token = HttpContext.Request.Cookies["AuthToken"];
                var user = HttpContext.Request.Cookies["UserName"];
            }

            @if (!string.IsNullOrEmpty(token))
            {
                <span class="greeting">Xin chào, @user</span>
                <a asp-page="/Logout">Đăng xuất</a>
            }
            else
            {
                <a asp-page="/Signin">Đăng nhập</a>
                <a asp-page="/Signup">Đăng ký</a>
            }
        </div>
</div>
<div class="back-nav-wrapper">
    <div class="content-limit">
        <a asp-page="/AdminPage" class="back-to-admin">
            <i class="fas fa-chevron-left"></i> Quay về trang Admin
        </a>
    </div>
</div>
<div class="container">
    <form method="post" asp-page-handler="SaveProduct" asp-route-id="@Model.Product.id" enctype="multipart/form-data">
    <div class="product-box">
        <!-- LEFT: IMAGE -->
        <div class="left">
            <img id="productImage" src="http://localhost:5014/@Model.Product.imageUrl" />
            <input type="file" name="UploadedImage" id="imageInput" hidden onchange="previewImage(this)" />
            <button type="button" onclick="document.getElementById('imageInput').click()">Thay ảnh</button>
        </div>

        <!-- RIGHT: INFO -->
        <div class="right">

            <!-- ID dropdown -->
            <label>ID:</label>
            <select id="productId" onchange="changeProduct()">
                @foreach (var p in Model.AllProducts)
                {
                    <option value="@p.id" selected="@(p.id == Model.Product.id)">
                        @p.id
                    </option>
                }
            </select>

                <label>Tên sản phẩm:</label>
                <input type="text" name="ProductName" value="@Model.Product.name" />

                <label>Mô tả:</label>
                <textarea name="ProductDescription">@Model.Product.description</textarea>

                <label asp-for="Product.price">Giá tiền:</label>
                    <div class="price-input-wrapper">
                        @* Chuyển sang type="text" để cho phép hiển thị dấu chấm *@
                        <input id="PriceFormat" 
                            class="form-control" 
                            type="text" 
                            placeholder="Ví dụ: 50.000" 
                            value="@(Model.Product.price > 0 ? Model.Product.price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) : "")" />
                        
                        @* Hidden field để lưu giá trị số thực tế gửi về Server *@
                        <input type="hidden" asp-for="Product.price" id="ProductPriceRaw" />
                        
                        <span class="currency-symbol">₫</span>
                    </div>
                <button type="submit" class="save-btn" style="background-color: #28a745; margin-top: 20px;">Lưu lại</button>
        </div>

    </div>
    </form>
</div>

<!-- 🔥 Footer -->
<div class="footer">
    <div class="left">
        <h3>Đom Đóm nhỏ HCMUE</h3>
        <p>SĐT: 0999999999</p>
        <p>Địa chỉ: Trường ĐH Sư phạm TP.HCM</p>
    </div>

    <div class="right">
        <iframe 
            src="https://www.google.com/maps?q=Đại học Sư phạm TP.HCM&output=embed">
        </iframe>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // đổi món khi chọn ID
    function changeProduct() {
        const id = document.getElementById("productId").value;
        window.location.href = "/ProductDetail/" + id;
    }

    // preview ảnh
    document.getElementById("imageInput").addEventListener("change", function (e) {
        const file = e.target.files[0];
        if (file) {
            document.getElementById("productImage").src = URL.createObjectURL(file);
        }
    });
    document.addEventListener("DOMContentLoaded", function () {
        // Lấy dữ liệu từ TempData thông qua Razor
        var successMsg = "@Html.Raw(TempData["SuccessMsg"])";
        var errorMsg = "@Html.Raw(TempData["ErrorMsg"])";

        if (successMsg) {
        Swal.fire({
        icon: 'success',
        title: 'Thành công!',
        text: successMsg,
        timer: 2000,
        showConfirmButton: false
        });
        }

        if (errorMsg) {
        Swal.fire({
        icon: 'error',
        title: 'Rất tiếc...',
        text: errorMsg,
        confirmButtonColor: '#d33'
        });
        }
        });

        document.addEventListener('DOMContentLoaded', function () {
    const displayInput = document.getElementById('PriceFormat');
    const rawInput = document.getElementById('ProductPriceRaw');

    displayInput.addEventListener('input', function (e) {
        // 1. Lấy giá trị chỉ bao gồm số
        let value = e.target.value.replace(/\D/g, '');

        // 2. Lưu giá trị số thuần túy vào hidden input để gửi lên server
        rawInput.value = value;

        // 3. Định dạng lại hiển thị có dấu chấm
        if (value) {
            e.target.value = new Intl.NumberFormat('vi-VN').format(value);
        } else {
            e.target.value = '';
        }
    });
});
</script>