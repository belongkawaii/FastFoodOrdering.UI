@page "{id?}"
@model ProductDetailModel
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<link rel="stylesheet" href="~/css/productdetail.css" />
<link rel="stylesheet" href="~/css/site.css" />

<!-- 🔥 Banner -->
<div class="banner">
    <img id="banner-img" src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200">
</div>

<!-- Navbar -->
<div class="navbar">
    <div class="left">
        <a asp-page="/Index">Trang chủ</a>
        <a href="#">Giới thiệu</a>
        <a href="#">Món ăn đề xuất</a>
    </div>
    <div class="right">
            @{
                var token = HttpContext.Request.Cookies["AuthToken"];
                var user = HttpContext.Request.Cookies["UserName"];
            }

            @if (!string.IsNullOrEmpty(token))
            {
                <span class="greeting">Xin chào, @user</span>
                <a asp-page="/Logout">Đăng xuất</a>
            }
            else
            {
                <a asp-page="/Signin">Đăng nhập</a>
                <a asp-page="/Signup">Đăng ký</a>
            }
        </div>
</div>
<div class="container">
    <a asp-page="/AdminPage" class="back-to-admin">
        <i class="fas fa-chevron-left"></i> Quay về trang Admin
    </a>
    <div class="product-box">
        <!-- LEFT: IMAGE -->
        <div class="left">
            <img id="productImage" src="http://localhost:5014/@Model.Product.imageUrl" alt="Ảnh sản phẩm" />          
            <input type="file" id="imageInput" hidden />
            <button onclick="document.getElementById('imageInput').click()">
                Chọn ảnh
            </button>
        </div>

        <!-- RIGHT: INFO -->
        <div class="right">

            <!-- ID dropdown -->
            <label>ID:</label>
            <select id="productId" onchange="changeProduct()">
                @foreach (var p in Model.AllProducts)
                {
                    <option value="@p.id" selected="@(p.id == Model.Product.id)">
                        @p.id
                    </option>
                }
            </select>

            <label>Tên món:</label>
            <input id="name" value="@Model.Product.name" />

            <label>Giá:</label>
            <input id="price" type="number" value="@Model.Product.price" />

            <button class="save-btn" onclick="saveProduct()">Lưu thay đổi</button>
        </div>

    </div>
</div>

<!-- 🔥 Footer -->
<div class="footer">
    <div class="left">
        <h3>Đom Đóm nhỏ HCMUE</h3>
        <p>SĐT: 0999999999</p>
        <p>Địa chỉ: Trường ĐH Sư phạm TP.HCM</p>
    </div>

    <div class="right">
        <iframe 
            src="https://www.google.com/maps?q=Đại học Sư phạm TP.HCM&output=embed">
        </iframe>
    </div>
</div>

<script>
    // đổi món khi chọn ID
    function changeProduct() {
        const id = document.getElementById("productId").value;
        window.location.href = "/ProductDetail/" + id;
    }

    // preview ảnh
    document.getElementById("imageInput").addEventListener("change", function (e) {
        const file = e.target.files[0];
        if (file) {
            document.getElementById("productImage").src = URL.createObjectURL(file);
        }
    });

    async function saveProduct() {
    const data = {
        id: document.getElementById("productId").value,
        name: document.getElementById("name").value,
        price: parseFloat(document.getElementById("price").value),
        imageUrl: document.getElementById("productImage").src 
    };

    try {
        const res = await fetch("http://localhost:5014/api/admin/products/" + data.id, {
            method: "PUT",
            headers: { 
                "Content-Type": "application/json",
                "Authorization": "Bearer " + authToken // 🔥 Thêm dòng này để gửi Token
            },
            body: JSON.stringify(data)
        });

        if (res.ok) {
            alert("Lưu thành công!");
            window.location.reload(); // Load lại trang để cập nhật dữ liệu mới
        } else if (res.status === 401 || res.status === 403) {
            alert("Lỗi: Bạn không có quyền chỉnh sửa (Yêu cầu quyền Admin)!");
        } else {
            alert("Lỗi khi lưu dữ liệu!");
        }
    } catch (error) {
        console.error("Error:", error);
        alert("Không thể kết nối đến máy chủ API!");
    }
}
</script>