@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<link rel="stylesheet" href="~/css/site.css">

<!-- 🔥 Banner -->
<div class="banner">
    <img id="banner-img" src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200">
</div>

<!-- 🔥 Navbar -->
<div class="navbar">
    <div class="left">
        <a href="#">Trang chủ</a>
        <a href="#">Giới thiệu</a>
        <a href="#">Món ăn đề xuất</a>
        <a href="#" class="cart">
            🛒 Giỏ hàng <span id="cart-count">0</span>
        </a>
    </div>

    <div class="right">
        <a href="#" class="btn-open">Đăng nhập</a>
        <a href="#" >Đăng ký</a>
    </div>
</div>

@* Login Page *@
    <div class="login-page hidden" id="login-page">
        <button class="btn-x" id="btn-x" onclick="closePageLogin()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <form>
            <div class="login-info">
                <h1>Login</h1>
                <p>Login to use our services.</p>
            </div>
            <div class="login-form">
                <input placeholder="Email" type="email" id="email"/>
                <input placeholder="Password" type="password" id="password" />
                <p id="error-msg" class="error hidden"></p>
            </div>
        
            <div class="login-function">
                <a href="#">Quên Mật Khẩu?</a>
                <a href="#">Đăng Ký Tài Khoản</a>
            </div>
            <button class="btn-login">Login</button>
        </form>
    </div>
    <div class="overlay hidden"></div>

<!-- 🔥 Main layout -->
<div class="container">

    <!-- Sidebar trái -->
    <div class="sidebar">
        <h3>Món hot 🔥</h3>
        <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?w=300">
        <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=300">
    </div>

    <!-- 🔥 Product -->
    <div class="products">
    @foreach (var p in Model.Products)
    {
        <div class="product">
            <img src="@p.image">
            <h4 class="product-name">
                <span>@p.title</span>
            </h4>
            <button onclick="addToCart()">Đặt hàng</button>
        </div>
        }
    </div>

    <!-- Sidebar phải -->
    <div class="sidebar">
        <h3>Quảng cáo</h3>
        <img src="https://images.unsplash.com/photo-1506089676908-3592f7389d4d?w=300">
        <img src="https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?w=300">
    </div>

</div>

<!-- 🔥 Footer -->
<div class="footer">
    <div class="left">
        <h3>Đom Đóm nhỏ HCMUE</h3>
        <p>SĐT: 0999999999</p>
        <p>Địa chỉ: Trường ĐH Sư phạm TP.HCM</p>
    </div>

    <div class="right">
        <iframe 
            src="https://www.google.com/maps?q=Đại học Sư phạm TP.HCM&output=embed">
        </iframe>
    </div>
</div>

<script src="~/js/site.js"></script>