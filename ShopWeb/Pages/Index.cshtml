@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<link rel="stylesheet" href="~/css/site.css">

<!-- 🔥 Banner -->
<div class="banner">
    <img id="banner-img" src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200">
</div>

<!-- 🔥 Navbar -->
<div class="navbar">
    @{
        var token = HttpContext.Request.Cookies["AuthToken"];
        var user = HttpContext.Request.Cookies["UserName"];
    }

    <div class="left">
        <a asp-page="/Index">Trang chủ</a>
        <a href="/ComingSoon">Giới thiệu</a>
        <a href="/ComingSoon">Món ăn đề xuất</a>

        @if (!string.IsNullOrEmpty(token))
        {
            <a asp-page="/Cart" class="cart">
                🛒 Giỏ hàng <span id="cart-count">@(Model.Carts?.TotalQuantity ?? 0)</span>
            </a>
            <a asp-page="/OrderHistory">Lịch sử mua hàng</a>
        }
    </div>

    <div class="right">
        @if (!string.IsNullOrEmpty(token))
        {
            <span class="greeting">Xin chào, @user</span>
            <a asp-page="/Logout">Đăng xuất</a>
        }
        else
        {
            <a asp-page="/Signin">Đăng nhập</a>
            <a asp-page="/Signup">Đăng ký</a>
        }
    </div>
</div>

            


<!-- 🔥 Main layout -->
<div class="container">

    <!-- Sidebar trái -->
    <div class="sidebar">
        <h3>Món hot 🔥</h3>
        <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?w=300">
        <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=300">
    </div>

    <!-- 🔥 Product -->
    <div class="products">
    @foreach (var p in Model.Products)
    {
         string imageUrl = "https://fastfoodorderingsystem-gaeka7bbhncrhnhp.southeastasia-01.azurewebsites.net" + p.imageUrl;
        <div class="product">
            <img src="@imageUrl">
            <h4 class="product-name">
                <span>@p.name</span>
            </h4>
            <div class="product-price">
            <span class="amount">@p.price.ToString("0.00")</span>
            <span class="currency">VND</span>
            </div>
            <form method="post">
                <button type="submit" asp-page-handler="AddItem">Thêm vào giỏ hàng</button>
                <input type="hidden" name="productId" value="@p.id" />
            </form>
        </div>
        }
    </div>

    <!-- Sidebar phải -->
    <div class="sidebar">
        <h3>Quảng cáo</h3>
        <img src="https://images.unsplash.com/photo-1506089676908-3592f7389d4d?w=300">
        <img src="https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?w=300">
    </div>

</div>

<!-- 🔥 Footer -->
<div class="footer">
    <div class="left">
        <h3>Đom Đóm nhỏ HCMUE</h3>
        <p>SĐT: 0999999999</p>
        <p>Địa chỉ: Trường ĐH Sư phạm TP.HCM</p>
    </div>

    <div class="right">
        <iframe 
            src="https://www.google.com/maps?q=Đại học Sư phạm TP.HCM&output=embed">
        </iframe>
    </div>
</div>

<script src="~/js/site.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        // Lấy dữ liệu từ TempData thông qua Razor
        var successMsg = "@Html.Raw(TempData["SuccessMsg"])";
        var errorMsg = "@Html.Raw(TempData["ErrorMsg"])";

        if (successMsg) {
        Swal.fire({
        icon: 'success',
        title: 'Thành công!',
        text: successMsg,
        timer: 2000,
        showConfirmButton: false
        });
        }

        if (errorMsg) {
        Swal.fire({
        icon: 'error',
        title: 'Rất tiếc...',
        text: errorMsg,
        confirmButtonColor: '#d33'
        });
        }
        });
    </script>