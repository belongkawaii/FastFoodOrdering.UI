@page
@model ShopWeb.Pages.CartModel
@{
    ViewData["Title"] = "Giỏ Hàng";
}

<link rel="stylesheet" href="~/css/cart.css" />

<div class="banner">
    <img id="banner-img" src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200">
</div>

<!-- 🔥 Navbar -->
<div class="navbar">
    <div class="left">
        <a asp-page="/Index">Trang chủ</a>
        <a href="#">Giới thiệu</a>
        <a href="#">Món ăn đề xuất</a>
        <a asp-page="/Cart" class="cart">
            🛒 Giỏ hàng <span id="cart-count">@Model.Carts.TotalQuantity</span>
        </a>
    </div>

    <div class="right">
        <a href="#" class="btn-open">Đăng nhập</a>
        <a asp-page="/Signup">Đăng ký</a>
    </div>
</div>


<div class="cart-container">
    <h2>🛒 Giỏ hàng của bạn</h2>

    @if (Model.Carts.items == null || !Model.Carts.items.Any())
    {
        <div class="empty-cart">Giỏ hàng trống</div>
    }
    else
    {
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Ảnh</th>
                    <th>Tên</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Carts.items)
                {
                    string imageUrl = "https://localhost:7214" + item.product.imageUrl;

                    <tr>
                        <td>
                            <img class="cart-img" src="@imageUrl" />
                        </td>
                        <td>@item.product.name</td>

                        <td class="price">
                            @item.product.price đ
                        </td>

                        <!-- 🔥 Quantity -->
                        <td>
                            <div class="quantity-box">
                                <form method="post" asp-page-handler="Decrease">
                                    <input type="hidden" name="itemId" value="@item.id" />
                                    <button class="quantity-btn">-</button>
                                </form>

                                <span>@item.quantity</span>

                                <form method="post" asp-page-handler="Increase">
                                    <input type="hidden" name="itemId" value="@item.id" />
                                    <button class="quantity-btn">+</button>
                                </form>
                            </div>
                        </td>

                        <!-- 🔥 Total -->
                        @{
                            var total = item.product.price * item.quantity;
                        }
                        <td class="price">
                            @total.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                        </td>

                        <!-- 🔥 Remove -->
                        <td>
                            <form method="post" asp-page-handler="Remove">
                                <input type="hidden" name="itemId" value="@item.id" />
                                <button class="remove-btn">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- 🔥 Summary -->
        <div class="cart-summary">
            <h4>Tổng SL: @Model.Carts.TotalQuantity</h4>
            <h3>Tổng tiền: @Model.Carts.TotalAmount.ToString("N0") đ</h3>
            <button class="checkout-btn">Thanh toán</button>
        </div>
    }
</div>

<!-- 🔥 Footer -->
<div class="footer">
    <div class="left">
        <h3>Đom Đóm nhỏ HCMUE</h3>
        <p>SĐT: 0999999999</p>
        <p>Địa chỉ: Trường ĐH Sư phạm TP.HCM</p>
    </div>

    <div class="right">
        <iframe src="https://www.google.com/maps?q=Đại học Sư phạm TP.HCM&output=embed">
        </iframe>
    </div>
</div>