@page
@model ShopWeb.Pages.CartModel
@{
    ViewData["Title"] = "Giỏ Hàng";
}

<link rel="stylesheet" href="~/css/cart.css" />

@Html.AntiForgeryToken()

<div class="banner">
    <img id="banner-img" src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200">
</div>

<div class="navbar">
    <div class="left">
        <a asp-page="/Index">Trang chủ</a>
        <a href="#">Giới thiệu</a>
        <a href="#">Món ăn đề xuất</a>
        <a asp-page="/Cart" class="cart">
            🛒 Giỏ hàng <span id="cart-count">@Model.Carts?.TotalQuantity</span>
        </a>
    </div>
    <div class="right">
        @{
            var token = HttpContext.Request.Cookies["AuthToken"];
            var user = HttpContext.Request.Cookies["UserName"];
        }
        @if (!string.IsNullOrEmpty(token))
        {
            <span class="greeting">Xin chào, @user</span>
            <a asp-page="/Logout">Đăng xuất</a>
        }
        else
        {
            <a asp-page="/Signin">Đăng nhập</a>
            <a asp-page="/Signup">Đăng ký</a>
        }
    </div>
</div>

<div class="cart-container">
    <h2>🛒 Giỏ hàng của bạn</h2>

    @if (Model.Carts?.items == null || !Model.Carts.items.Any())
    {
        <div class="empty-cart">Giỏ hàng trống</div>
    }
    else
    {
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Ảnh</th>
                    <th>Tên</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Carts.items)
                {
                    string imageUrl = "http://localhost:5014" + item.product.imageUrl;
                    var total = item.product.price * item.quantity;

                    <tr id="row-@item.id">
                        <td><img class="cart-img" src="@imageUrl" /></td>
                        <td>@item.product.name</td>
                        <td class="price">@item.product.price.ToString("N0") đ</td>

                        <td>
                            <div class="quantity-box">
                                <button type="button" class="quantity-btn" onclick="updateItem('Decrease', @item.id, @item.productId)">-</button>
                                <span id="qty-@item.id">@item.quantity</span>
                                <button type="button" class="quantity-btn" onclick="updateItem('Increase', @item.id, @item.productId)">+</button>
                            </div>
                        </td>

                        <td class="price" id="item-total-@item.id">
                            @total.ToString("N0") đ
                        </td>

                        <td>
                            <button type="button" class="remove-btn" onclick="updateItem('Remove', @item.id, @item.productId)">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="cart-summary">
            <h4 id="cart-total-qty">Tổng SL: @Model.Carts.TotalQuantity</h4>
            <h3 id="cart-total-amount">Tổng tiền: @Model.Carts.TotalAmount.ToString("N0") đ</h3>
            <a asp-page="/Checkout" class="checkout-btn">Thanh toán</a>
        </div>
    }
</div>

<div class="footer">
    <div class="left">
        <h3>Đom Đóm nhỏ HCMUE</h3>
        <p>SĐT: 0999999999</p>
        <p>Địa chỉ: Trường ĐH Sư phạm TP.HCM</p>
    </div>
    <div class="right">
        <iframe src="https://www.google.com/maps?q=Đại học Sư phạm TP.HCM&output=embed"></iframe>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // 🔥 Tuyệt chiêu AJAX giúp web không bị F5
    function updateItem(action, itemId, productId) {
        // Lấy mã bảo vệ AntiForgeryToken để C# cho phép chạy
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        // Bắn tín hiệu ngầm xuống Backend
        fetch(`/Cart?handler=${action}&itemId=${itemId}&productId=${productId}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken
            }
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (action === 'Remove' || data.newQuantity === 0) {
                    // Nếu xóa, làm hiệu ứng mờ dòng rồi xóa khỏi bảng
                    const row = document.getElementById(`row-${itemId}`);
                    row.style.opacity = '0';
                    setTimeout(() => row.remove(), 300);
                } else {
                    // Cập nhật số lượng và thành tiền của món đó
                    document.getElementById(`qty-${itemId}`).innerText = data.newQuantity;
                    document.getElementById(`item-total-${itemId}`).innerText = data.itemTotal + ' đ';
                }

                // Cập nhật thông tin tổng giỏ hàng & Navbar
                document.getElementById('cart-total-qty').innerText = `Tổng SL: ${data.cartTotalQty}`;
                document.getElementById('cart-total-amount').innerText = `Tổng tiền: ${data.cartTotalAmount} đ`;
                document.getElementById('cart-count').innerText = data.cartTotalQty; 

                // Nếu xóa sạch giỏ hàng thì load lại trang để hiện chữ "Giỏ hàng trống"
                if (data.cartTotalQty === 0) {
                    location.reload();
                }
            } else {
                Swal.fire('Thất bại', data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Lỗi AJAX:', error);
            Swal.fire('Lỗi', 'Không kết nối được với hệ thống.', 'error');
        });
    }
</script>