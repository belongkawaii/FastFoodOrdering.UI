@page
@model ShopWeb.Pages.SigninModel
@{
    ViewData["Title"] = "Đăng Nhập";
}

<link rel="stylesheet" href="~/css/signup.css" />

<div class="top-banner">
    <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200">
</div>

<div class="navbar">
    <div class="left">
        <a asp-page="/Index">Trang chủ</a>
        <a href="/ComingSoon">Giới thiệu</a>
        <a href="/ComingSoon">Món ăn đề xuất</a>
    </div>

    <div class="right">
        @{
            
            var token = HttpContext.Request.Cookies["AuthToken"];
            var user = HttpContext.Request.Cookies["UserName"];
        }

        @if (!string.IsNullOrEmpty(token))
        {
            <span class="greeting" style="margin-right: 15px; font-weight: bold; color: #ee4d2d;">Xin chào, @user</span>
            <a asp-page="/Logout">Đăng xuất</a>
        }
        else
        {
           
        }
    </div>
</div>

<div class="signup-container">
    <div class="signup-left">
        <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=800">
    </div>

    <div class="signup-right">
        <div class="form-outer">
            <div class="form-inner">
                <h2>Đăng nhập</h2>

                <form method="post" asp-page-handler="Login" id="form-login">
                    
                    <input asp-for="Email" placeholder="Email" required />
                    <span asp-validation-for="Email" class="error hidden"></span>

                    <input asp-for="Password" type="password" placeholder="Mật khẩu" required />
                    <span asp-validation-for="Password" class="error hidden"></span>

                    @if (TempData["ErrorMessageLogin"] != null)
                    {
                        <p class="error" style="display: block; margin-top: 10px; color: red;">
                            @TempData["ErrorMessageLogin"]
                        </p>
                    }

                    <button type="submit" style="margin-top: 15px;">Đăng nhập</button>

                    <div class="extra">
                        <a href="/ForgotPassword">Quên mật khẩu?</a>
                        <a asp-page="/Signup">Tạo tài khoản mới</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="footer">
    <div class="left">
        <h3>Đom Đóm nhỏ HCMUE</h3>
        <p>SĐT: 0999999999</p>
        <p>Địa chỉ: Trường ĐH Sư phạm TP.HCM</p>
    </div>

    <div class="right">
        <iframe src="https://www.google.com/maps?q=Đại học Sư phạm TP.HCM&output=embed"></iframe>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
    var successMsg = "@Html.Raw(TempData["SuccessMsg"])";
    var errorMsg = "@Html.Raw(TempData["ErrorMsg"])";

    if (successMsg) {
    Swal.fire({ icon: 'success', title: 'Thành công!', text: successMsg, timer: 2000, showConfirmButton: false });
    }
    if (errorMsg) {
    Swal.fire({ icon: 'error', title: 'Rất tiếc...', text: errorMsg, confirmButtonColor: '#d33' });
    }
    });
</script>