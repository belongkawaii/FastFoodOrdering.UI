@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["HeroBadge"] = "Khôi phục truy cập";
    ViewData["HeroTitle"] = "Lấy lại mật khẩu an toàn";
    ViewData["HeroSubtitle"] = "Nhập email đã đăng ký để nhận mã OTP và đặt lại mật khẩu trong vài bước ngắn gọn.";
}

<link rel="stylesheet" href="~/css/signup.css">
<partial name="_SiteHeader" />

<div class="site-shell-main site-shell-main--auth">
<div class="signup-container">
    <div class="signup-left">
        <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=800">
    </div>

    <div class="signup-right">
        <div class="form-outer">
            <div class="form-inner">
                <h2>Quên mật khẩu</h2>

                <form id="form-forgot">
                    <div id="step-1-email">
                        <p style="font-size: 14px; color: #555; margin-bottom: 10px;">Vui lòng nhập email bạn đã đăng ký để nhận mã khôi phục.</p>
                        <input type="email" placeholder="Nhập Email của bạn" id="email" />
                    </div>

                    <div id="step-2-reset" class="hidden">
                        <input type="text" placeholder="Nhập 6 số OTP trong email" id="otpCode" maxlength="6" style="border: 2px solid #007bff; margin-bottom: 15px;" />
                        <input type="password" placeholder="Mật khẩu mới" id="newPassword"/>
                        <input type="password" placeholder="Xác nhận mật khẩu mới" id="confirmPassword" />
                    </div>

                    <p id="error-message" class="error hidden"></p>

                    <button type="submit" id="submitBtn">Gửi mã OTP</button>
                </form>

                <div class="extra">
                    <a asp-page="/Signin">Quay lại Đăng nhập</a>
                    <a asp-page="/Signup">Tạo tài khoản mới</a>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
<partial name="_SiteFooter" />

<script src="~/js/forgotpassword.js"></script>
