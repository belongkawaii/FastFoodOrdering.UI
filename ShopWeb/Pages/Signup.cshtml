@page
@model SignupModel
@{
    ViewData["Title"] = "Đăng ký";
}

<link rel="stylesheet" href="~/css/signup.css">

<div class="top-banner">
    <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200">
</div>

<div class="navbar">
    <div class="left">
        <a asp-page="/Index">Trang chủ</a>
        <a href="#">Giới thiệu</a>
        <a href="#">Món ăn đề xuất</a>
    </div>
</div>


<div class="signup-container">


    <div class="signup-left">
        <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=800">
    </div>


    <div class="signup-right">

   
        <div class="form-outer">

           
            <div class="form-inner">

                <h2>Đăng ký</h2>

                <form method="post">

                    <input type="text" placeholder="Tên đăng nhập" asp-for="Username" />

                    <input type="email" placeholder="Email" asp-for="Email" />

                    <input type="password" placeholder="Mật khẩu" asp-for="Password" />

                    <input type="password" placeholder="Xác nhận mật khẩu" asp-for="ConfirmPassword" />

                    <button type="submit">Đăng ký</button>

                </form>

                <div class="extra">
                    <a href="#">Quên mật khẩu?</a>
                    <a asp-page="/Signin">Đăng nhập</a>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="footer">
    <div class="left">
        <h3>Đom Đóm nhỏ HCMUE</h3>
        <p>SĐT: 0999999999</p>
        <p>Địa chỉ: Trường ĐH Sư phạm TP.HCM</p>
    </div>

    <div class="right">
        <iframe 
            src="https://www.google.com/maps?q=Đại học Sư phạm TP.HCM&output=embed">
        </iframe>
    </div>
</div>