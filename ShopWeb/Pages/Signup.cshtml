@page
@model SignupModel
@{
    ViewData["Title"] = "Đăng ký";
    ViewData["HeroBadge"] = "Tạo tài khoản mới";
    ViewData["HeroTitle"] = "Bắt đầu trải nghiệm đặt món cùng Đom Đóm nhỏ";
    ViewData["HeroSubtitle"] = "Đăng ký nhanh để lưu thông tin, đặt món tiện hơn và theo dõi lịch sử mua hàng.";
}

<link rel="stylesheet" href="~/css/signup.css">
<partial name="_SiteHeader" />

<div class="site-shell-main site-shell-main--auth">
<div class="signup-container">


    <div class="signup-left">
        <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=800">
    </div>


    <div class="signup-right">

   
        <div class="form-outer">

           
            <div class="form-inner">

                <h2>Đăng ký</h2>

                <form id="form-register">

                    <input type="text" placeholder="Tên đăng nhập" id="fullName" />

                    <input type="email" placeholder="Email" id="email" />

                    <input type="text" placeholder="Số điện thoại" id="phone" />

                    <input type="password" placeholder="Mật khẩu" id="password"/>

                    <input type="password" placeholder="Xác nhận mật khẩu" id="confirmPassword" />

                    <input type="text" placeholder="Nhập 6 số OTP trong email" id="otpCode" class="hidden" maxlength="6" style="border: 2px solid #007bff; margin-top: 10px;" />

                    <p id="error-message" class="error hidden"></p>

                    <button type="submit" id="submitBtn">Gửi mã OTP</button>

                </form>

                <div class="extra">
                    <a asp-page="/ForgotPassword">Quên mật khẩu?</a>
                    <a asp-page="/Signin">Đăng nhập</a>
                </div>

            </div>
        </div>
    </div>
</div>
</div>
<partial name="_SiteFooter" />

<script src="~/js/signup.js"></script>
