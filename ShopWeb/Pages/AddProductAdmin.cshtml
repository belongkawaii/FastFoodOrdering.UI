@page
@model AddProductAdminModel
@using System.Globalization
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    ViewData["HeroBadge"] = "Thao tác quản trị";
    ViewData["HeroTitle"] = "Thêm món mới vào thực đơn";
    ViewData["HeroSubtitle"] = "Cập nhật hình ảnh, mô tả và giá bán trong một layout đồng bộ với trang chủ hiện tại.";
    // Giả sử giá trị là decimal hoặc int
    decimal price = 50000; 
    var formattedPrice = string.Format(new CultureInfo("vi-VN"), "{0:N0} ₫", price);
}

<link rel="stylesheet" href="~/css/productdetail.css" />
<partial name="_SiteHeader" />

<div class="site-shell-main site-shell-main--wide">
<div class="back-nav-wrapper">
    <div class="content-limit">
        <a asp-page="/AdminPage" class="back-to-admin">
            <i class="fas fa-chevron-left"></i> Quay về trang Admin
        </a>
    </div>
</div>

<div class="container">
    <form method="post" asp-page-handler="SaveProduct" asp-route-id="@Model.Product.id" enctype="multipart/form-data">
        <div class="product-box">
            
            <div class="left">
                <img id="productImage" style="display:none; max-width: 100%; border-radius: 8px;" />
                <div id="imagePlaceholder" style="width: 200px; height: 200px; background: #eee; display: flex; align-items: center; justify-content: center; border: 2px dashed #ccc;">
                    <span>Chưa có ảnh</span>
                </div>
                <input type="file" name="UploadedImage" id="imageInput" hidden onchange="previewImage(this)" required />
                <button type="button" onclick="document.getElementById('imageInput').click()" style="margin-top: 10px;">
                    Chọn ảnh sản phẩm
                </button>
            </div>

            <div class="right">
                <h2 style="margin-bottom: 20px;">Thông tin sản phẩm mới</h2>

                <label>Tên sản phẩm:</label>
                <input type="text" name="ProductName" placeholder="Nhập tên món ăn..." required />

                <label>Mô tả:</label>
                <textarea name="ProductDescription" rows="4" placeholder="Nhập mô tả món ăn..." required></textarea>

                <label asp-for="Product.price">Giá tiền:</label>
                    <div class="price-input-wrapper">
                        @* Chuyển sang type="text" để cho phép hiển thị dấu chấm *@
                        <input id="PriceFormat" 
                            class="form-control" 
                            type="text" 
                            placeholder="Ví dụ: 50.000" 
                            value="@(Model.Product.price > 0 ? Model.Product.price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) : "")" />
                        
                        @* Hidden field để lưu giá trị số thực tế gửi về Server *@
                        <input type="hidden" asp-for="Product.price" id="ProductPriceRaw" />
                        
                        <span class="currency-symbol">₫</span>
                    </div>

                <button type="submit" class="save-btn" style="background-color: #28a745; margin-top: 20px;">
                    Thêm sản phẩm mới
                </button>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div style="color: red; margin-top: 10px;">
                        @Html.ValidationSummary(true)
                    </div>
                }
            </div>
        </div>
    </form>
</div>
</div>
<partial name="_SiteFooter" />

<script>
    // Hàm preview ảnh và thay đổi hiển thị 
    function previewImage(input) {
        const preview = document.getElementById("productImage");
        const placeholder = document.getElementById("imagePlaceholder");

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = "block";
                placeholder.style.display = "none";
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
    const displayInput = document.getElementById('PriceFormat');
    const rawInput = document.getElementById('ProductPriceRaw');

    displayInput.addEventListener('input', function (e) {
        // 1. Lấy giá trị chỉ bao gồm số
        let value = e.target.value.replace(/\D/g, '');

        // 2. Lưu giá trị số thuần túy vào hidden input để gửi lên server
        rawInput.value = value;

        // 3. Định dạng lại hiển thị có dấu chấm
        if (value) {
            e.target.value = new Intl.NumberFormat('vi-VN').format(value);
        } else {
            e.target.value = '';
        }
    });
});
</script>
